<?xml version="1.0" encoding="utf-8"?><!--
   Backup/transfer rules for Android 12+ (API 31+).
   Riplox IG: history and small settings may be backed up, BUT Instagram login cookies
   (the session token) are excluded from BOTH cloud backup and device transfer
   (privacy/security). The temp cache of an in-flight download is excluded as well.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="cookies.txt" />
        <exclude domain="external" path="temp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cookies.txt" />
        <exclude domain="external" path="temp" />
    </device-transfer>
</data-extraction-rules>
